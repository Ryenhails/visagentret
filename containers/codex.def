Bootstrap: docker
From: node:22-bookworm-slim

# Codex CLI image for VisAgentRet episodes: bin/codex-gw runs `codex exec` in it, and Codex starts
# tools/mcp_vdr.py with the image's python3.
#
#   apptainer build --fakeroot codex.sif containers/codex.def
#
# Same base image, packages and Codex version as the image of our runs. That image also held tools
# the pipeline does not call.

%environment
    export CODEX_HOME=/home/node/.codex
    export NPM_CONFIG_UPDATE_NOTIFIER=false

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    # fakeroot builds cannot switch to the _apt sandbox user
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/00-apptainer-sandbox
    apt-get update
    apt-get install -y --no-install-recommends \
        bash \
        bubblewrap \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        openssh-client \
        procps \
        python3 \
        ripgrep \
        unzip \
        vim-tiny \
        xz-utils
    npm install -g --no-fund --no-audit @openai/codex@0.156.1
    npm cache clean --force
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    mkdir -p /workspace /home/node/.codex
